        </mxCell>
        <mxCell id="sim" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#16191F&quot;&gt;Simulador del Apocalipsis&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cada 2 s, en este orden:&lt;br&gt;eventos (puente o avenida cae)&lt;br&gt;→ se mueven los zombies&lt;br&gt;→ publica el Mundo&lt;br&gt;→ sobrevivientes piden /paso&lt;br&gt;→ mordidas, refugios y camionetas" style="rounded=1;html=1;whiteSpace=wrap;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#7D8998;strokeWidth=1.2;fontSize=12;fontColor=#333D47;" parent="contenedor" vertex="1">
