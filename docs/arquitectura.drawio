        <mxCell id="api" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#16191F&quot;&gt;API FastAPI&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;POST /paso&lt;/font&gt; &lt;span style=&quot;background-color:#FBBF24;color:#1F2937;font-weight:bold;&quot;&gt;&amp;nbsp;API KEY&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;/ws/sim/*&lt;/font&gt; &lt;span style=&quot;background-color:#F59E0B;color:#1F2937;font-weight:bold;&quot;&gt;&amp;nbsp;KEY OPERADOR&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;GET /estado&lt;/font&gt; &lt;span style=&quot;background-color:#1D8102;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;PÚBLICO&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;WS /ws&lt;/font&gt; &lt;span style=&quot;background-color:#1D8102;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;PÚBLICO&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;GET /salud&lt;/font&gt; &lt;span style=&quot;background-color:#1D8102;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;PÚBLICO&amp;nbsp;&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#7D8998;strokeWidth=1.2;fontSize=12;fontColor=#333D47;" parent="contenedor" vertex="1">
