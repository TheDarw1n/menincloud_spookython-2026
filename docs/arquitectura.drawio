        </mxCell>
        <mxCell id="flujo1_t" value="Página y grafo: Navegador → CloudFront → S3 (index.html, css/, js/ y manta_graph.json, con OAC)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#333D47;" parent="1" vertex="1">
          <mxGeometry x="60" y="888" width="740" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flujo2" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="34" y="908" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flujo2_t" value="Estado en vivo: WS /ws (o GET /estado cada 2 s) → CloudFront → ALB → API, que lee el Mundo publicado." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#333D47;" parent="1" vertex="1">
          <mxGeometry x="60" y="908" width="740" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flujo3" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="34" y="928" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flujo3_t" value="POST /paso con x-api-key → CloudFront → ALB → ruta ASGI directa → consulta las tablas del planner (&amp;lt; 500 ms)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#333D47;" parent="1" vertex="1">
          <mxGeometry x="60" y="928" width="740" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flujo4" value="4" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="34" y="948" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flujo4_t" value="Turno de 2 s: el simulador aplica eventos y mueve zombies → publica el Mundo → el planner recalcula 1 vez → /paso." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#333D47;" parent="1" vertex="1">
          <mxGeometry x="60" y="948" width="740" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flujo5" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="814" y="888" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flujo5_t" value="Snapshot cada 10 turnos y resultado de cada ronda → DynamoDB (manta-task-role)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#333D47;" parent="1" vertex="1">
          <mxGeometry x="840" y="888" width="740" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flujo6" value="6" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="814" y="908" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flujo6_t" value="Logs JSON del contenedor → CloudWatch Logs; filtros de métricas y alarmas opcionales (p95, errores, mordidos)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#333D47;" parent="1" vertex="1">
          <mxGeometry x="840" y="908" width="740" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flujo7" value="7" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="814" y="928" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flujo7_t" value="Despliegue: docker buildx ARM64 → ECR → ecs update-service; frontend: s3 sync + invalidación de CloudFront." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#333D47;" parent="1" vertex="1">
          <mxGeometry x="840" y="928" width="740" height="20" as="geometry" />
        </mxCell>
        <mxCell id="nota" value="Notas: el ALB es internet-facing, pero su SG solo admite el prefix list de CloudFront (header x-origin-verify listo, sin activar) · WebSocket por CloudFront Free probado (si falla, polling de /estado) · /estado y /ws son públicos por PUBLIC_STATE=true." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#333D47;fontColor=#545B64;" parent="1" vertex="1">
          <mxGeometry x="34" y="970" width="1530" height="20" as="geometry" />
        </mxCell>
      </root>
