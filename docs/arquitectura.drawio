        <mxCell id="planner" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#16191F&quot;&gt;Planner de rutas&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1 Dijkstra inverso por refugio, 1 vez por turno&lt;br&gt;costo = segundos por tipo de calle + riesgo&lt;br&gt;nodos con zombie y zonas de horda: prohibidos&lt;br&gt;POST /paso solo consulta estas tablas&lt;br&gt;&lt;span style=&quot;background-color:#0F766E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;PRO&amp;nbsp;&lt;/span&gt; predicción de corredores&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;capacidad de refugios · flota de 5 camionetas" style="rounded=1;html=1;whiteSpace=wrap;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#7D8998;strokeWidth=1.2;fontSize=12;fontColor=#333D47;" parent="contenedor" vertex="1">
