{
  "_AVISO": "RECONSTRUIDA a partir de la configuracion descrita, NO exportada. Reemplazar por el JSON real de la consola (ECS > Task definitions > manta-api > JSON) quitando taskDefinitionArn, revision, status, registeredAt, registeredBy, requiresAttributes y compatibilities. Sin valores secretos: API_KEY es solo una referencia a SSM. Reemplazar <ACCOUNT_ID>.",
  "family": "manta-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {"cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX"},
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/manta-execution-role",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/manta-task-role",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/manta-zombie:latest",
      "essential": true,
      "portMappings": [{"containerPort": 8000, "protocol": "tcp"}],
      "environment": [
        {"name": "AWS_REGION", "value": "us-east-1"},
        {"name": "SNAPSHOTS_TABLE", "value": "manta-snapshots"},
        {"name": "PUBLIC_STATE", "value": "true"},
        {"name": "SIM_AUTOSTART", "value": "none"},
        {"name": "SIM_MODO", "value": "http"},
        {"name": "TURNO_S", "value": "2.0"}
      ],
      "secrets": [
        {"name": "API_KEY", "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/manta/api-key"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/manta-zombie",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
